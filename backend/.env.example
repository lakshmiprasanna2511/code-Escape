# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=YOUR URL 

MONGODB_DB=codeescape

# JWT run it in terminal ( node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" )


JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
